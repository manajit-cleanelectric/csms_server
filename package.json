{
  "name": "ocpp-rpc-express-server",
  "version": "1.0.0",
  "description": "OCPP-RPC server implementation with Express.js",
  "main": "src/index.ts",
  "scripts": {
    "start": "nodemon",
    "test": "jest",
    "docs": "typedoc",
    "docs:serve": "typedoc && npx http-server docs -p 8080 -o",
    "typeorm:migration:gen": "node -r ts-node/register --env-file=.env ./node_modules/typeorm/cli.js migration:generate -d src/database/datasource.ts",
    "typeorm:migration:run": "node -r ts-node/register --env-file=.env ./node_modules/typeorm/cli.js migration:run -d src/database/datasource.ts"
  },
  "author": "Achyut Salunkhe",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "firebase-admin": "^13.5.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "ocpp-rpc": "^2.2.0",
    "pg": "^8.16.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.1",
    "razorpay": "^2.9.6",
    "sharp": "^0.34.3",
    "typeorm": "^0.3.25",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.2",
    "@types/nodemailer": "^7.0.1",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "jest": "^30.0.5",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.13",
    "typedoc-plugin-markdown": "^4.8.1",
    "typescript": "^5.9.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34"
  },
  "engines": {
    "node": "^v22.19.0"
  }
}
